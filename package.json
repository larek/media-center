{
  "name": "video-player",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Audio Player with S3 storage",
  "scripts": {
    "dev": "pnpm --filter @video-player/web dev",
    "build": "pnpm --filter @video-player/web build",
    "preview": "pnpm --filter @video-player/web preview",
    "mobile": "pnpm --filter @video-player/mobile start",
    "mobile:android": "pnpm --filter @video-player/mobile android",
    "mobile:ios": "pnpm --filter @video-player/mobile ios",
    "server": "node server/index.js",
    "migrate": "node server/db/migrate.js up",
    "migrate:down": "node server/db/migrate.js down"
  },
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.800.0",
    "@aws-sdk/lib-storage": "^3.995.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "multer": "^1.4.5-lts.2",
    "pg": "^8.13.0"
  }
}
